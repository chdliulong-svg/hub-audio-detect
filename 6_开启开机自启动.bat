@echo off
cd /d "%~dp0"
chcp 65001 >nul
title 开启轮毂异响检测系统开机自启动

echo ======================================================================
echo 🚀 正在配置【开机/重启自动静默唤醒监控系统】...
echo ======================================================================
echo.

python autostart.py --enable
if %errorlevel% equ 0 (
    echo.
    echo ======================================================================
    echo [OK] 开机自启动配置成功！
    echo >> 自启动模式: 零黑框后台静默启动 (模型加载就绪后自动弹出监控大屏)
    echo >> 如需取消自启动，随时双击运行【取消开机自启动.bat】即可。
    echo ======================================================================
) else (
    echo.
    echo [ERROR] 配置开机自启动失败，请检查 Python 环境或右键以管理员身份重试。
)

echo.
pause
