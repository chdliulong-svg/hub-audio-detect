@echo off
cd /d "%~dp0"
chcp 65001 >nul
title 取消风电机组碰撞声学智能诊断系统开机自启动

echo ======================================================================
echo 🛑 正在注销【开机/重启自动静默唤醒监控系统】...
echo ======================================================================
echo.

python autostart.py --disable
if %errorlevel% equ 0 (
    echo.
    echo ======================================================================
    echo [OK] 开机自启动已成功注销！
    echo >> 启动项已彻底清理，系统开机后将不再自动启动监控服务。
    echo >> 如后续需重新启用，双击运行【6_开启开机自启动.bat】即可。
    echo ======================================================================
) else (
    echo.
    echo [ERROR] 注销失败，请检查 Python 环境或右键以管理员身份重试。
)

echo.
pause
